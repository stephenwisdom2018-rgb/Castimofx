// Castimofx CHoCH OTE
// The "CHoCH OTE SELL / BUY" setup:
//   1. Change of character (CHoCH): price closes through the last swing against the trend.
//   2. Fibonacci over the leg that broke structure. OTE zone = 62%-79% retracement.
//   3. Limit entry at 70.5%, stop beyond the leg origin, TP1 50% / TP2 0% / TP3 -27% / TP4 -62%.
//   4. PSY levels: psychological round numbers (full / ½ / ¼ of 100 on gold).
// Same rules as the Python backtester (castimofx/ote.py) and the MT5 EA (mt5/CastimofxOTE.mq5).
//@version=5
indicator("Castimofx CHoCH OTE", shorttitle = "CFX OTE", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 2000)

// ───────────────────────────── Inputs ─────────────────────────────
grpS = "Setup"
swingLen  = input.int(5, "Swing length", minval = 2, maxval = 50, group = grpS)
allowBos  = input.bool(false, "Also trade BOS (not only CHoCH)", group = grpS)
oteEntry  = input.float(0.705, "Entry level", minval = 0.5, maxval = 0.95, step = 0.005, group = grpS)
oteLo     = input.float(0.62, "OTE zone from", step = 0.01, group = grpS, inline = "z")
oteHi     = input.float(0.79, "to", step = 0.01, group = grpS, inline = "z")
slBufAtr  = input.float(0.2, "Stop buffer beyond leg origin (x ATR)", minval = 0, step = 0.05, group = grpS)
minLegAtr = input.float(1.5, "Min leg size (x ATR)", minval = 0, step = 0.1, group = grpS)
maxLegAtr = input.float(15.0, "Max leg size (x ATR)", minval = 1, step = 0.5, group = grpS)
expiryBars = input.int(48, "Cancel unfilled order after (bars)", minval = 1, group = grpS)

grpT = "Take profits (Fibonacci level of the leg, % of position)"
tp1L = input.float(0.5,   "TP1", step = 0.01, group = grpT, inline = "1")
tp1P = input.float(25,    "%",   minval = 0, maxval = 100, group = grpT, inline = "1")
tp2L = input.float(0.0,   "TP2", step = 0.01, group = grpT, inline = "2")
tp2P = input.float(25,    "%",   minval = 0, maxval = 100, group = grpT, inline = "2")
tp3L = input.float(-0.27, "TP3", step = 0.01, group = grpT, inline = "3")
tp3P = input.float(25,    "%",   minval = 0, maxval = 100, group = grpT, inline = "3")
tp4L = input.float(-0.62, "TP4", step = 0.01, group = grpT, inline = "4")
tp4P = input.float(25,    "%",   minval = 0, maxval = 100, group = grpT, inline = "4")
beAfterTp1 = input.bool(true, "Move stop to breakeven after TP1", group = grpT)

grpF = "Accuracy filters (all off = the plain setup)"
useSweep = input.bool(false, "Leg must sweep the previous swing (liquidity grab)", group = grpF)
useOb    = input.bool(false, "OTE zone must overlap the order block", group = grpF)
usePsy   = input.bool(false, "A PSY level must sit inside the OTE zone", group = grpF)
displAtr = input.float(0.0, "Breaking candle at least (x ATR, 0 = off)", minval = 0, step = 0.1, group = grpF)
htfTf    = input.timeframe("", "Higher-timeframe trend filter (empty = off)", group = grpF)
useSess  = input.bool(false, "Only fill inside session", group = grpF, inline = "s")
sess     = input.session("0700-2000", "", group = grpF, inline = "s")

grpD = "Display"
showPsy   = input.bool(true, "PSY levels", group = grpD, inline = "p")
psyBase   = input.float(100, "full level every", minval = 0.0001, group = grpD, inline = "p")
psyCount  = input.int(4, "PSY lines each side of price", minval = 1, maxval = 20, group = grpD)
showZone  = input.bool(true, "Sell / buy zone (order block)", group = grpD)
showStats = input.bool(true, "Results table", group = grpD)
bullCol   = input.color(#089981, "Buy", group = grpD, inline = "c")
bearCol   = input.color(#F23645, "Sell", group = grpD, inline = "c")
entryCol  = input.color(#2962FF, "Entry", group = grpD, inline = "c")

// ───────────────────────────── Helpers ─────────────────────────────
atr = ta.atr(14)
f_px(float p) => str.tostring(p, format.mintick)

f_trend(int L) =>
    var int   tr = 0
    var float h0 = na
    var float l0 = na
    var bool  hb = true
    var bool  lb = true
    ph = ta.pivothigh(high, L, L)
    pl = ta.pivotlow(low, L, L)
    if not na(ph)
        h0 := ph
        hb := false
    if not na(pl)
        l0 := pl
        lb := false
    if not hb and close > h0
        hb := true
        tr := 1
    if not lb and close < l0
        lb := true
        tr := -1
    tr

htfRaw   = request.security(syminfo.tickerid, htfTf == "" ? timeframe.period : htfTf, f_trend(swingLen)[1], lookahead = barmerge.lookahead_on)
htfTrend = htfTf == "" ? 0 : htfRaw
inSess   = not useSess or not na(time(timeframe.period, sess))

// ───────────────────────────── Structure ─────────────────────────────
var int   trend    = 0
var float shPrice  = na
var int   shBar    = na
var bool  shBroken = true
var float slPrice  = na
var int   slBar    = na
var bool  slBroken = true
var array<float> swHiP = array.new<float>()
var array<int>   swHiI = array.new<int>()
var array<float> swLoP = array.new<float>()
var array<int>   swLoI = array.new<int>()

// ───────────────────────────── Setup & position state ─────────────────────────────
var int   sDir = 0            // pending setup: 1 buy, -1 sell, 0 none
var float sOrigin = na
var float sExtreme = na
var int   sCreated = na
var float sAtr = na
var float sObTop = na
var float sObBot = na
var array<box>   sBoxes  = array.new<box>()     // OTE zone + stop box of the pending setup
var array<label> sigLbls = array.new<label>()   // CHoCH OTE label of the pending setup
var array<line>  tpLines = array.new<line>()
var array<label> tpLbls  = array.new<label>()

var int   pDir = 0            // open position
var float pEntry = na
var float pStop = na
var float pStop0 = na
var int   pBar = na
var int   pHit = 0
var float pLeft = 0.0
var float pR = 0.0
var array<float> pTps = array.new<float>(4, na)

var int   nTrades = 0
var int   nTp1 = 0
var int   nWins = 0
var float netR = 0.0

lvl(float f) => sExtreme + f * (sOrigin - sExtreme)
tpLevels = array.from(tp1L, tp2L, tp3L, tp4L)
tpPcts   = array.from(tp1P, tp2P, tp3P, tp4P)
tpSum    = tp1P + tp2P + tp3P + tp4P

f_clear() =>
    for bx in sBoxes
        box.delete(bx)
    array.clear(sBoxes)
    for lb in sigLbls
        label.delete(lb)
    array.clear(sigLbls)
    for ln in tpLines
        line.delete(ln)
    for lb in tpLbls
        label.delete(lb)
    array.clear(tpLines)
    array.clear(tpLbls)

f_draw() =>
    col = sDir == 1 ? bullCol : bearCol
    buf = slBufAtr * sAtr
    stop = sOrigin + (sDir == -1 ? buf : -buf)
    entry = lvl(oteEntry)
    right = bar_index + 15
    for bx in sBoxes
        box.delete(bx)
    array.clear(sBoxes)
    array.push(sBoxes, box.new(sCreated, math.max(lvl(oteLo), lvl(oteHi)), right, math.min(lvl(oteLo), lvl(oteHi)),
         border_color = color.new(entryCol, 40), bgcolor = color.new(entryCol, 85),
         text = "OTE " + str.tostring(oteLo * 100) + "-" + str.tostring(oteHi * 100) + "%", text_size = size.tiny,
         text_color = entryCol, text_halign = text.align_left, text_valign = text.align_top))
    array.push(sBoxes, box.new(sCreated, math.max(entry, stop), right, math.min(entry, stop), border_color = color.new(color.red, 60),
         bgcolor = color.new(color.red, 85), text = "SL " + f_px(stop), text_size = size.tiny, text_color = color.red,
         text_halign = text.align_right, text_valign = sDir == -1 ? text.align_top : text.align_bottom))
    for ln in tpLines
        line.delete(ln)
    for lb in tpLbls
        label.delete(lb)
    array.clear(tpLines)
    array.clear(tpLbls)
    array.push(tpLines, line.new(sCreated, entry, right, entry, color = entryCol, width = 2))
    array.push(tpLbls, label.new(right, entry, (sDir == 1 ? "BUY " : "SELL ") + f_px(entry), style = label.style_label_left,
         color = entryCol, textcolor = color.white, size = size.small))
    for i = 0 to 3
        p = lvl(array.get(tpLevels, i))
        array.push(tpLines, line.new(sCreated, p, right, p, color = color.new(bullCol, 30), style = line.style_dashed))
        array.push(tpLbls, label.new(right, p, "TP" + str.tostring(i + 1) + "  " + f_px(p), style = label.style_label_left,
             color = bullCol, textcolor = color.white, size = size.small))
    stop

// ── 1) manage the open position
tpHitNow = 0
slHitNow = false
if pDir != 0 and bar_index > pBar
    stopHit = pDir == -1 ? high >= pStop : low <= pStop
    if stopHit
        gap = pDir == -1 ? open >= pStop : open <= pStop
        px = gap ? open : pStop
        pR += pLeft * (px - pEntry) * pDir / math.abs(pStop0 - pEntry)
        slHitNow := true
    else
        while pHit < 4
            tp = array.get(pTps, pHit)
            reached = pDir == -1 ? low <= tp : high >= tp
            if not reached
                break
            frac = array.get(tpPcts, pHit) / tpSum
            pR += frac * (tp - pEntry) * pDir / math.abs(pStop0 - pEntry)
            pLeft -= frac
            pHit += 1
            tpHitNow := pHit
            if pHit == 1 and beAfterTp1
                pStop := pEntry
    if slHitNow or pHit == 4
        nTrades += 1
        nTp1 += pHit >= 1 ? 1 : 0
        nWins += pR > 0 ? 1 : 0
        netR += pR
        pDir := 0

// ── 2) fill the pending limit order (levels from the previous close)
filledNow = false
fillDir = 0
if sDir != 0 and pDir == 0 and inSess
    entry = lvl(oteEntry)
    touched = sDir == -1 ? high >= entry : low <= entry
    if touched
        zLo = math.min(lvl(oteLo), lvl(oteHi))
        zHi = math.max(lvl(oteLo), lvl(oteHi))
        bad = math.abs(sOrigin - sExtreme) > maxLegAtr * sAtr
        bad := bad or (useOb and not (sObBot <= zHi and sObTop >= zLo))
        psyStep = psyBase / 4
        bad := bad or (usePsy and math.floor(zHi / psyStep) * psyStep < zLo)
        if bad
            f_clear()
        else
            fill = sDir == -1 ? math.max(open, entry) : math.min(open, entry)
            buf = slBufAtr * sAtr
            stop = sOrigin + (sDir == -1 ? buf : -buf)
            if sDir == -1 ? fill < stop : fill > stop
                pDir := sDir
                pEntry := fill
                pStop := stop
                pStop0 := stop
                pBar := bar_index
                pHit := 0
                pLeft := 1.0
                pR := 0.0
                for i = 0 to 3
                    array.set(pTps, i, lvl(array.get(tpLevels, i)))
                filledNow := true
                fillDir := sDir
                if sDir == -1 ? high >= stop : low <= stop
                    pR := -1.0
                    nTrades += 1
                    netR += pR
                    pDir := 0
                    slHitNow := true
        sDir := 0

// ── 3) structure, then extend / cancel / create the setup
ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)
if not na(ph)
    shPrice := ph
    shBar := bar_index - swingLen
    shBroken := false
    array.push(swHiP, ph)
    array.push(swHiI, shBar)
    if array.size(swHiP) > 100
        array.shift(swHiP)
        array.shift(swHiI)
if not na(pl)
    slPrice := pl
    slBar := bar_index - swingLen
    slBroken := false
    array.push(swLoP, pl)
    array.push(swLoI, slBar)
    if array.size(swLoP) > 100
        array.shift(swLoP)
        array.shift(swLoI)

brkDir = 0
brkChoch = false
brkFrom = 0
if not shBroken and close > shPrice
    shBroken := true
    brkChoch := trend == -1
    trend := 1
    brkDir := 1
    brkFrom := shBar
if not slBroken and close < slPrice
    slBroken := true
    brkChoch := trend == 1
    trend := -1
    brkDir := -1
    brkFrom := slBar

if sDir != 0
    if (sDir == -1 and close > sOrigin) or (sDir == 1 and close < sOrigin) or bar_index >= sCreated + expiryBars or trend != sDir
        f_clear()
        sDir := 0
    else
        if sDir == -1 and low < sExtreme
            sExtreme := low
        if sDir == 1 and high > sExtreme
            sExtreme := high
        f_draw()

newSetup = false
if brkDir != 0 and (brkChoch or allowBos)
    d = brkDir
    n = math.min(bar_index - brkFrom, 1500)
    // leg origin: the extreme between the broken swing and now
    oP = d == -1 ? high : low
    oB = bar_index
    for k = 0 to n
        v = d == -1 ? high[k] : low[k]
        if d == -1 ? v >= oP : v <= oP
            oP := v
            oB := bar_index - k
    ext = d == -1 ? low : high
    for k = 0 to bar_index - oB
        ext := d == -1 ? math.min(ext, low[k]) : math.max(ext, high[k])
    // order block: last opposite candle at / before the origin
    obI = oB
    for j = 0 to 5
        k = bar_index - oB + j
        if d == -1 ? close[k] > open[k] : close[k] < open[k]
            obI := oB - j
            break
    // sell: top = highest high from the OB candle to the origin; buy: bottom = lowest low (mirrors the Python code)
    obTop = high[bar_index - obI]
    obBot = low[bar_index - obI]
    for k = bar_index - oB to bar_index - obI
        if d == -1
            obTop := math.max(obTop, high[k])
        else
            obBot := math.min(obBot, low[k])
    // sweep: the origin ran past the previous swing of the same kind
    swept = false
    if d == -1 and array.size(swHiP) > 0
        for i = array.size(swHiP) - 1 to 0
            if array.get(swHiI, i) < obI
                swept := oP > array.get(swHiP, i)
                break
    if d == 1 and array.size(swLoP) > 0
        for i = array.size(swLoP) - 1 to 0
            if array.get(swLoI, i) < obI
                swept := oP < array.get(swLoP, i)
                break
    ok = math.abs(oP - ext) >= minLegAtr * atr
    ok := ok and (not useSweep or swept)
    ok := ok and (displAtr <= 0 or high - low >= displAtr * atr)
    ok := ok and (htfTf == "" or htfTrend == d)
    if ok
        if sDir != 0
            f_clear()
        sDir := d
        sOrigin := oP
        sExtreme := ext
        sCreated := bar_index
        sAtr := atr
        sObTop := obTop
        sObBot := obBot
        newSetup := true
        stp = f_draw()
        array.push(sigLbls, label.new(oB, oP, "CHoCH OTE " + (d == 1 ? "BUY" : "SELL") + (allowBos and not brkChoch ? " (BOS)" : ""),
             style = d == -1 ? label.style_label_down : label.style_label_up, color = d == 1 ? bullCol : bearCol,
             textcolor = color.white, size = size.small))
        if showZone
            box.new(obI, obTop, bar_index + 15, obBot, border_color = color.new(color.teal, 50), bgcolor = color.new(color.teal, 88),
                 text = d == -1 ? "sell zone" : "buy zone", text_color = d == -1 ? bearCol : bullCol, text_size = size.small)
        alert("CHoCH OTE " + (d == 1 ? "BUY" : "SELL") + " " + syminfo.ticker + ": " + (d == 1 ? "BUY" : "SELL") + " LIMIT @ " +
             f_px(lvl(oteEntry)) + "  SL " + f_px(stp) + "  TP1 " + f_px(lvl(tp1L)) + "  TP2 " + f_px(lvl(tp2L)) +
             "  TP3 " + f_px(lvl(tp3L)) + "  TP4 " + f_px(lvl(tp4L)) + "  (entry moves if the leg extends)", alert.freq_once_per_bar_close)

if filledNow
    alert((fillDir == 1 ? "BUY" : "SELL") + " filled " + syminfo.ticker + " @ " + f_px(pEntry), alert.freq_once_per_bar_close)
if tpHitNow > 0
    alert("TP" + str.tostring(tpHitNow) + " hit " + syminfo.ticker + (tpHitNow == 1 and beAfterTp1 ? " - stop moved to breakeven" : ""), alert.freq_once_per_bar_close)
if slHitNow
    alert("Stop hit " + syminfo.ticker, alert.freq_once_per_bar_close)

plotshape(tpHitNow > 0, "TP hit", shape.diamond, location.abovebar, color.new(bullCol, 0), size = size.tiny)
plotshape(slHitNow, "Stop hit", shape.xcross, location.abovebar, color.new(color.red, 0), size = size.tiny)

// ───────────────────────────── PSY levels ─────────────────────────────
var array<line>  psyLines = array.new<line>()
var array<label> psyLbls  = array.new<label>()
if showPsy and barstate.islast
    for ln in psyLines
        line.delete(ln)
    for lb in psyLbls
        label.delete(lb)
    array.clear(psyLines)
    array.clear(psyLbls)
    step = psyBase / 4
    base = math.round(close / step)
    for k = -psyCount to psyCount
        q = base + k
        p = q * step
        m = q % 4
        kind = m == 0 ? "PSY " : (m == 2 or m == -2) ? "PSY ½ " : "PSY ¼ "
        w = m == 0 ? 2 : 1
        array.push(psyLines, line.new(bar_index - 150, p, bar_index + 20, p, color = color.new(#9C27B0, m == 0 ? 30 : 60), width = w))
        array.push(psyLbls, label.new(bar_index + 20, p, kind + f_px(p), style = label.style_none, textcolor = color.new(#9C27B0, 20), size = size.tiny))

// ───────────────────────────── Results table ─────────────────────────────
var table tbl = table.new(position.top_right, 2, 5, bgcolor = color.new(color.black, 20), border_width = 1)
if showStats and barstate.islast
    table.cell(tbl, 0, 0, "CHoCH OTE", text_color = color.white)
    table.cell(tbl, 1, 0, "on this chart", text_color = color.gray)
    table.cell(tbl, 0, 1, "Trades", text_color = color.white)
    table.cell(tbl, 1, 1, str.tostring(nTrades), text_color = color.white)
    table.cell(tbl, 0, 2, "TP1 hit", text_color = color.white)
    table.cell(tbl, 1, 2, nTrades > 0 ? str.tostring(100.0 * nTp1 / nTrades, "#.#") + "%" : "-", text_color = color.white)
    table.cell(tbl, 0, 3, "Win rate", text_color = color.white)
    table.cell(tbl, 1, 3, nTrades > 0 ? str.tostring(100.0 * nWins / nTrades, "#.#") + "%" : "-", text_color = color.white)
    table.cell(tbl, 0, 4, "Net R (no spread)", text_color = color.white)
    table.cell(tbl, 1, 4, str.tostring(netR, "#.##"), text_color = netR >= 0 ? bullCol : bearCol)
